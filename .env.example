# ─────────────────────────────────────────────────────────────
# Backend API / Worker
# ─────────────────────────────────────────────────────────────

# Database connection string.
# MySQL:      mysql://user:password@host:3306/job_scheduler
# Postgres:   postgres://user:password@host:5432/job_scheduler
DATABASE_URL="mysql://user:password@localhost:3306/job_scheduler"

# Set to "true" to enable SSL for managed Postgres (Render/Railway/Neon/Supabase).
# Automatically enabled when NODE_ENV=production for Postgres.
DATABASE_SSL="false"

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET="your-jwt-secret"

# Port the API listens on. Hosting platforms (Render/Railway) inject PORT.
PORT=3000

# development | production
NODE_ENV="development"

# Optional: Redis connection for BullMQ. If unset/unreachable, the worker falls
# back to database polling automatically.
# REDIS_URL="redis://localhost:6379"

# CORS allowlist for the API. Comma-separated list of allowed dashboard origins,
# e.g. "https://your-dashboard.onrender.com". If unset, the API reflects the
# request origin (fine for demos; set an explicit allowlist for production).
# CORS_ORIGIN="https://your-dashboard.onrender.com"

# ─────────────────────────────────────────────────────────────
# Frontend (apps/web) — MUST be set at BUILD time
# ─────────────────────────────────────────────────────────────

# Public URL of the deployed backend API. The browser uses this to reach the
# API, so it can NEVER be localhost in production. Next.js inlines NEXT_PUBLIC_*
# values during `next build`, so this must be present when the web app is built.
# Example: https://scheduler-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:3000"
